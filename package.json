{
  "name": "npcart",
  "version": "0.1.0",
  "private": true,
  "description": "NPCart — catálogo de minis impresas en 3D con pedido por WhatsApp",
  "workspaces": [
    "frontend",
    "backend",
    "packages/pricing"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,yellow \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend && npm run typecheck -w backend",
    "test": "npm run test -w packages/pricing && npm run test -w frontend",
    "typecheck": "npm run typecheck -w packages/pricing && npm run typecheck -w backend && npm run typecheck -w frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.20.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
